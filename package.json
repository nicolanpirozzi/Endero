{
  "name": "endero-sito",
  "private": true,
  "description": "Sito di Endero: pagine statiche generate da script Node, servite da un Worker Cloudflare.",
  "scripts": {
    "build": "node build/costruisci.mjs",
    "anteprima": "node build/costruisci.mjs && node build/servi.mjs",
    "worker": "node build/costruisci.mjs && wrangler dev",
    "db:locale": "wrangler d1 execute endero --local --file db/schema.sql",
    "gusto": "node build/costruisci.mjs && node tools/gusto.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/kv-asset-handler": "0.4.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "esbuild": "^0.25.12",
    "meshoptimizer": "^1.3.0",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "lenis": "1.3.27",
    "three": "^0.180.0"
  }
}
