{
  "name": "endero-sito",
  "private": true,
  "description": "Sito di Endero: pagine statiche generate da script Node, servite da un Worker Cloudflare.",
  "scripts": {
    "build": "node build/costruisci.mjs",
    "anteprima": "node build/costruisci.mjs && node build/servi.mjs",
    "worker": "node build/costruisci.mjs && wrangler dev",
    "db:locale": "wrangler d1 execute endero --local --file db/schema.sql"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "wrangler": "^4.162.0"
  }
}
